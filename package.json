{
  "name": "@coreax/sdk",
  "private": false,
  "version": "1.0.0",
  "description": "Standalone deterministic security boundary for untrusted AI and agent actions.",
  "license": "MIT",
  "author": "WormAI, Inc.",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./policy": {
      "types": "./dist/policy/index.d.ts",
      "default": "./dist/policy/index.js"
    },
    "./evaluator": {
      "types": "./dist/evaluator/index.d.ts",
      "default": "./dist/evaluator/index.js"
    },
    "./signer": {
      "types": "./dist/signer/index.d.ts",
      "default": "./dist/signer/index.js"
    },
    "./runtime-adapter": {
      "types": "./dist/runtime-adapter/index.d.ts",
      "default": "./dist/runtime-adapter/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./audit": {
      "types": "./dist/audit/index.d.ts",
      "default": "./dist/audit/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "default": "./dist/middleware/index.js"
    },
    "./escalation": {
      "types": "./dist/escalation/index.d.ts",
      "default": "./dist/escalation/index.js"
    },
    "./guard": {
      "types": "./dist/guard/index.d.ts",
      "default": "./dist/guard/index.js"
    },
    "./governance": {
      "types": "./dist/governance/index.d.ts",
      "default": "./dist/governance/index.js"
    },
    "./runtime-risk": {
      "types": "./dist/runtime-risk/index.d.ts",
      "default": "./dist/runtime-risk/index.js"
    },
    "./policy-learning": {
      "types": "./dist/policy-learning/index.d.ts",
      "default": "./dist/policy-learning/index.js"
    },
    "./instrumentation": {
      "types": "./dist/instrumentation/index.d.ts",
      "default": "./dist/instrumentation/index.js"
    },
    "./integrations/custom-agent": {
      "types": "./dist/integrations/custom-agent/index.d.ts",
      "default": "./dist/integrations/custom-agent/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "public/coreax-image.png",
    "public/coreax-logo-adaptive.svg",
    "public/coreax-logo-black.png",
    "public/coreax-logo-white.png",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "rimraf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "repository:check": "node ./tools/verify-standalone.mjs .",
    "pack:check": "node ./tools/verify-tarball.mjs",
    "consumer:check": "node ./tools/verify-consumer.mjs",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "audit:licenses": "node ./tools/verify-licenses.mjs",
    "publish:guard": "node ./tools/guard-npm-publish.mjs",
    "prepublishOnly": "npm run publish:guard && npm run verify",
    "lint": "npm run repository:check && npm run typecheck",
    "verify": "npm run lint && npm run test && npm run build && npm run audit:dependencies && npm run audit:licenses && npm run pack:check && npm run consumer:check"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "tweetnacl": "^1.0.3",
    "yaml": "^2.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.19.23",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teluashish0/coreax-sdk.git"
  },
  "homepage": "https://github.com/teluashish0/coreax-sdk#readme",
  "bugs": {
    "url": "https://github.com/teluashish0/coreax-sdk/issues"
  },
  "keywords": [
    "coreax",
    "security",
    "ai",
    "agents",
    "guardrails",
    "governance",
    "audit",
    "runtime-risk",
    "policy-learning"
  ]
}
